{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Портфолио Дмитрия Николаева — Next.js 16, App Router, FSD",
  "author": "Дмитрий Николаев <pegeoner@mail.ru>",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./src/fsd",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier --config linting/.prettierrc.cjs --write .",
    "format:check": "prettier --config linting/.prettierrc.cjs --check .",
    "content:validate": "tsx scripts/validate-content.ts",
    "audit:security": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run lint:fsd && npm run content:validate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --config linting/.prettierrc.cjs --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{css,scss}": [
      "prettier --config linting/.prettierrc.cjs --write",
      "stylelint --fix"
    ],
    "*.{json,md,mjs,cjs}": [
      "prettier --config linting/.prettierrc.cjs --write"
    ]
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lenis": "^1.3.17",
    "motion": "12.43.0",
    "next": "16.2.12",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "schema-dts": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "husky": "9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "steiger": "0.6.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
